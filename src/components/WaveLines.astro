---
// Líneas concéntricas de la portada del portafolio. Solo decoración.
const { class: className = '', lines = 4, strokeWidth = 2 } = Astro.props
const paths = Array.from({ length: lines }, (_, i) => {
  const o = i * 16
  return `M${-20 + o} 320 C ${40 + o} 230, ${30 + o} 150, ${120 + o} ${110 - o * 0.2} S ${250 + o * 0.4} ${40 - o}, ${330} ${-10 + o * 0.6}`
})
---

<svg viewBox="0 0 320 320" fill="none" aria-hidden="true" class={`pointer-events-none ${className}`}>
  {paths.map((d) => <path d={d} stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />)}
</svg>
