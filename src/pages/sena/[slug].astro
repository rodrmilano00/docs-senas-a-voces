---
import Base from '../../layouts/Base.astro'
import SignPlayer from '../../components/SignPlayer.jsx'
import ReportForm from '../../components/ReportForm.jsx'
import signs from '../../../data/signs.json'
import { CATEGORIAS } from '../../lib/categorias'

export function getStaticPaths() {
  return signs.map((sign, i) => ({
    params: { slug: sign.slug },
    props: { sign, previous: signs[i - 1], next: signs[i + 1] },
  }))
}

const { sign, previous, next } = Astro.props
const related = signs.filter((s) => s.categoria === sign.categoria && s.slug !== sign.slug).slice(0, 12)
const hands = sign.manos === 2 ? 'Dos manos' : 'Una mano'
---

<Base
  title={`${sign.palabra} en Lengua de Señas Mexicana (LSM)`}
  description={`Mira cómo se dice “${sign.palabra}” en Lengua de Señas Mexicana con una animación a tu ritmo.`}
>
  <article class="container-page pt-6 pb-16 sm:pt-8">
    <div class="grid gap-x-16 gap-y-6 lg:grid-cols-[1.25fr_1fr] lg:grid-rows-[auto_1fr]">
      <div class="lg:col-start-2">
        <h1 class="text-[clamp(44px,6vw,72px)]">{sign.palabra}</h1>
        {sign.sinonimos.length > 0 && <p class="mt-3 text-[20px] text-muted">También: {sign.sinonimos.join(', ')}</p>}
      </div>
      <div class="min-w-0 lg:col-start-1 lg:row-span-2 lg:row-start-1">
        <SignPlayer client:load slug={sign.slug} palabra={sign.palabra} video={sign.video} />
      </div>
      <div class="lg:col-start-2">
        <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-[17px]">
          <dt class="text-muted">Tema</dt>
          <dd><a class="text-link" href={`/buscar?categoria=${sign.categoria}`}>{CATEGORIAS[sign.categoria]}</a></dd>
          <dt class="text-muted">Manos</dt>
          <dd><a class="text-link" href={`/buscar?manos=${sign.manos}`}>{hands}</a></dd>
        </dl>
        {!sign.revisada && (
          <p class="mt-8 flex items-baseline gap-2.5 text-[15px] font-bold text-amber-ink">
            <span aria-hidden="true" class="size-2 shrink-0 translate-y-[-1px] rounded-full bg-amber"></span>
            En revisión con personas sordas
          </p>
        )}
        <div class="mt-6">
          <ReportForm client:visible palabra={sign.palabra} />
        </div>
      </div>
    </div>

    {related.length > 0 && (
      <section class="mt-20" aria-labelledby="relacionadas">
        <h2 id="relacionadas" class="text-[clamp(26px,2.4vw,32px)]">Más en {CATEGORIAS[sign.categoria]}</h2>
        <ul class="mt-6 grid grid-cols-2 gap-x-8 gap-y-2 text-[20px] sm:grid-cols-3 lg:grid-cols-4">
          {related.map((s) => <li><a class="hover:text-petrol hover:underline hover:decoration-amber hover:decoration-2 hover:underline-offset-[6px]" href={`/sena/${s.slug}`}>{s.palabra}</a></li>)}
        </ul>
      </section>
    )}

    <nav aria-label="Señas vecinas" class="mt-16 flex justify-between gap-6 text-[17px]">
      {previous ? <a class="text-link" href={`/sena/${previous.slug}`} rel="prev">Anterior: {previous.palabra}</a> : <span />}
      {next && <a class="text-link text-right" href={`/sena/${next.slug}`} rel="next">Siguiente: {next.palabra}</a>}
    </nav>
  </article>
</Base>
